{
  "dependencies": {
    "@playwright/test": "^1.65.1",
    "@turbodocx/html-to-docx": "^1.23.3",
    "marked": "^18.2.1",
    "sanitize-html": "^2.18.2"
  },
  "name": "boom-doc",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Generate editable Markdown manuals from Playwright tests",
  "bin": {"boom-doc": "./dist/cli.js"},
  "exports": {"./fixture": {"types": "./src/fixture.ts", "default": "./dist/fixture.js"}},
  "engines": {"node": ">=24"},
  "type": "module",
  "scripts": {
    "prepack": "node scripts/build.mjs",
    "test": "tsc -p tests && node --test tests/reporter.test.ts tests/release.test.ts",
    "manual": "node src/cli.ts"
  },
  "files": [
    "dist/*.js",
    "src/fixture.ts",
    "go.mod",
    "internal/manual/main.go",
    "internal/manual/render.go",
    "internal/manual/update.go"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.5.438",
    "typescript": "~5.9.3"
  }
}
